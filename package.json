{
  "name": "@get-air/video",
  "version": "0.3.0",
  "author": "Air contributors",
  "description": "One lean DOM-first video API for HTML, native adapters, and smart TVs",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-air/video.git"
  },
  "homepage": "https://github.com/get-air/video#readme",
  "bugs": "https://github.com/get-air/video/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "./react/player.css",
    "./dist-js/framework.js"
  ],
  "keywords": [
    "video",
    "html5",
    "smart-tv"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "types": "./dist-js/guest-js/index.d.ts",
  "main": "./dist-js/index.js",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/guest-js/index.d.ts",
      "import": "./dist-js/index.js"
    },
    "./headless": {
      "types": "./dist-js/guest-js/index.d.ts",
      "import": "./dist-js/index.js"
    },
    "./controls": {
      "types": "./dist-js/guest-js/controls.d.ts",
      "import": "./dist-js/controls.js"
    },
    "./effect": {
      "types": "./dist-js/guest-js/effect.d.ts",
      "import": "./dist-js/effect.js"
    },
    "./canvas": {
      "types": "./dist-js/canvas/index.d.ts",
      "import": "./dist-js/canvas.js"
    },
    "./framework": {
      "types": "./dist-js/framework/index.d.ts",
      "import": "./dist-js/framework.js"
    },
    "./react": {
      "types": "./dist-js/react/index.d.ts",
      "import": "./dist-js/react.js"
    },
    "./react/styles.css": "./react/player.css"
  },
  "files": [
    "dist-js",
    "docs/*.md",
    "react/player.css",
    "CHANGELOG.md",
    "VERSIONING.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "ci": "npm run check && npm run build && npm pack --dry-run --ignore-scripts",
    "ci:act": "act push --job package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run check:effect && npm test",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict --format text",
    "check:release": "node scripts/check-release-consistency.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "allowScripts": { "esbuild": true },
  "dependencies": {
    "@get-air/http": "^0.1.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "@plussub/srt-vtt-parser": "^2.0.5",
    "effect": "^3.22.1"
  },
  "peerDependencies": {
    "@get-air/framework": ">=0.1.0 <0.2.0",
    "@get-air/renderer": ">=0.1.1 <0.2.0",
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "@get-air/framework": {
      "optional": true
    },
    "@get-air/renderer": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@get-air/framework": "0.1.0",
    "@get-air/renderer": "0.1.1",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^20.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.9.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
